# SIPREC SRS to vCon Server — environment configuration template
# Copy to `.env` and edit. Variables set here override the matching
# fields in config.yaml.

# --- Server (listen address, ports) -----------------------------------
SIPREC_LISTEN_ADDRESS=0.0.0.0
SIPREC_UDP_PORT=5060
SIPREC_TCP_PORT=5060
SIPREC_TLS_PORT=5061
# Path to PEM cert + key for TLS (leave unset to disable TLS):
# SIPREC_TLS_CERT=/etc/ssl/certs/siprec-srs.pem
# SIPREC_TLS_KEY=/etc/ssl/private/siprec-srs.key

# IP advertised in SDP answers and Contact headers. Set this when the bind
# address is not the address peers reach (NAT, container, cloud VM).
# SIPREC_PUBLIC_IP=203.0.113.10

# --- Storage ----------------------------------------------------------
SIPREC_STORAGE_PATH=./vcons
SIPREC_FILENAME_PATTERN={timestamp}_{call_id}.vcon.json

# S3 media publishing uses the standard AWS credential provider chain.
# Prefer an IAM role or web identity in production. These variables are
# supported by boto3 when static credentials are required:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_PROFILE=

# --- Webhook delivery -------------------------------------------------
SIPREC_WEBHOOK_ENABLED=true
SIPREC_WEBHOOK_URL=https://api.example.com/vcons
# SIPREC_WEBHOOK_TOKEN=your-bearer-token-here
SIPREC_WEBHOOK_RETRY_ATTEMPTS=3
SIPREC_WEBHOOK_TIMEOUT=30

# --- vCon retrieval API (GET /vcons, GET /vcons/<name> on health.port) ---
# Unset = API disabled (503 "vcon API disabled"). Set to enable; callers
# send "Authorization: Bearer <token>".
# SIPREC_VCON_API_TOKEN=change-me

# --- Logging ----------------------------------------------------------
SIPREC_LOG_LEVEL=INFO
# SIPREC_LOG_FILE=./logs/siprec-srs.log

# --- Lawful basis attachment -------------------------------------------
# No default (CON-1091): if lawful_basis stays enabled (the default) but
# this is unset, the adapter logs one warning and omits the attachment
# rather than guessing a basis.
# SIPREC_LAWFUL_BASIS_ENABLED=true
# SIPREC_LAWFUL_BASIS=legitimate_interests  # consent | contract | legal_obligation | vital_interests | public_task | legitimate_interests

# Note: signing.private_key_path, webhooks.dlq_path, media.*,
# lawful_basis.purposes/.expiration/.justification, and health.* are
# config-file-only; set them in config.yaml rather than here.
